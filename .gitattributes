# Normalize text files across operating systems
* text=auto

# Web/source files
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.nojekyll text eol=lf
CNAME text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
